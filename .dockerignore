# Large data — never baked into image; mounted as volumes at runtime
dataset/
checkpoints/

# Caches
.cache/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/*.egg-info/
dist/
build/

# Secrets & local config
.env
*.key
*.pem

# Dev / editor
.git/
.gitignore
*.md
.vscode/
.idea/

# Logs & tmp
*.log
/tmp/

# Docker build artifacts (avoid recursive context)
Dockerfile*
docker-compose*.yml
cloudbuild.yaml

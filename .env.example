# MGVaovao — environment variables
# Copy to .env and edit. All vars have sensible defaults.

# ── Device ────────────────────────────────────────────────────────────────
# MGVAOVAO_DEVICE=cuda          # cuda or cpu

# ── Paths (Docker defaults shown — override for local dev) ─────────────────
# MGVAOVAO_ROOT_DIR=/mgvaovao
# MGVAOVAO_CHECKPOINTS_DIR=/mgvaovao/checkpoints
# MGVAOVAO_DATASET_DIR=/mgvaovao/dataset
# MGVAOVAO_HF_CACHE_DIR=/mgvaovao/.cache/huggingface
# MGVAOVAO_TORCH_HUB_DIR=/mgvaovao/.cache/torch/hub

# ── Model sizes ───────────────────────────────────────────────────────────
# MGVAOVAO_WHISPER_MODEL_SIZE=small   # tiny|base|small|medium|large

# ── API ───────────────────────────────────────────────────────────────────
# MGVAOVAO_API_HOST=0.0.0.0
# MGVAOVAO_API_PORT=8000

# ── Gradio (UI only) ──────────────────────────────────────────────────────
# MGVAOVAO_API_URL=http://localhost:8000
# GRADIO_PORT=7860

# ── NLLB training overrides ───────────────────────────────────────────────
# MGVAOVAO_NLLB_TRAIN_EPOCHS=5
# MGVAOVAO_NLLB_BATCH_SIZE=1
# MGVAOVAO_NLLB_LR=0.0005
# MGVAOVAO_NLLB_FP16=true

# ── TTS training overrides ────────────────────────────────────────────────
# MGVAOVAO_TTS_TRAIN_EPOCHS=50
# MGVAOVAO_TTS_BATCH_SIZE=1
# MGVAOVAO_TTS_LR=0.0001

# ── VAD (batch mode) ──────────────────────────────────────────────────────
# MGVAOVAO_VAD_THRESHOLD=0.5
# MGVAOVAO_VAD_MIN_SPEECH_MS=250

# ── Streaming VAD (WebSocket endpoint /ws/stream/{dialect}) ───────────────
# Same threshold + min_speech_ms are reused.
# min_silence_ms controls how long silence must last to trigger pipeline:
# MGVAOVAO_VAD_MIN_SILENCE_MS=500   # 500 ms silence = end of utterance
